# The repository tracks the book: the .tex sources, the figures and tables LaTeX includes, the code and data
# that produce them, references.bib and the compiled IO_Textbook.pdf.

# Ignore everything at the top level except the book files
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/IO_Textbook.tex
!/IO_Textbook.pdf
!/preamble.tex
!/references.bib
!/chapters/
!/figures/

# Figure previews (the scripts and data in figures/chNN/src and figures/chNN/data are tracked)
figures/**/*_preview.png
figures/**/*_preview-*.png

# LaTeX build products
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.run.xml

# Caches and OS files
__pycache__/
*.pyc
.DS_Store
Thumbs.db
desktop.ini
