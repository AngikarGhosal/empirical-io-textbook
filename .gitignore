# The repository tracks only what is needed to build the book, plus the compiled PDF:
# the .tex sources, the figure files LaTeX includes, references.bib and IO_Textbook.pdf.

# Ignore everything at the top level except the book files
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/IO_Textbook.tex
!/IO_Textbook.pdf
!/preamble.tex
!/references.bib
!/chapters/
!/figures/

# Figure-making scripts, data and scratch output are not part of the book
figures/**/src/
figures/**/data/
figures/**/*.py
figures/**/*.csv
figures/**/*.json
figures/**/*.npz
figures/**/*.txt
figures/**/*_preview.png
figures/ch01/scp_montecarlo_table.tex
figures/ch07/einav_fig3.png
figures/ch07/logit_vs_blp.pdf
figures/ch07/mc_logit_table.tex
figures/ch07/mc_nl_table.tex
figures/ch15/krasno_fig4c.png

# LaTeX build products
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.run.xml

# Caches and OS files
__pycache__/
*.pyc
.DS_Store
Thumbs.db
desktop.ini
